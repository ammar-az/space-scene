{
	"name": "space-scene",
	"description": "A customizable space scene built with React, Vite, and Cloudflare Workers",
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"three": "0.187.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.67.0",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "6.2.1",
		"eslint": "10.14.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.14.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"wrangler": "4.156.2"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "npm run typecheck && npm run lint && npm test && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"typecheck": "tsc -b",
		"test": "node --test tests/*.test.mjs"
	},
	"type": "module",
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261101.1": true,
		"workerd@1.20261102.1": true
	}
}
